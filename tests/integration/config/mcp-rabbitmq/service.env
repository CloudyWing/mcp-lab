# Integration test settings; credentials belong to throwaway test containers.
RABBITMQ_CONN_LAB_HOST=test-rabbit
RABBITMQ_CONN_LAB_USER=lab
RABBITMQ_CONN_LAB_PASSWORD=labpass
MCPLAB_MCP_TOKEN=integration-test-token
RABBITMQ_CONN_TLS_HOST=test-rabbit
RABBITMQ_CONN_TLS_MGMTPORT=15671
RABBITMQ_CONN_TLS_USER=lab
RABBITMQ_CONN_TLS_PASSWORD=labpass
RABBITMQ_CONN_TLS_USE_TLS=true
RABBITMQ_CONN_TLS_SSL_SKIP_VERIFY=true
RABBITMQ_CONN_STRICT_HOST=test-rabbit
RABBITMQ_CONN_STRICT_MGMTPORT=15671
RABBITMQ_CONN_STRICT_USER=lab
RABBITMQ_CONN_STRICT_PASSWORD=labpass
RABBITMQ_CONN_STRICT_USE_TLS=true
