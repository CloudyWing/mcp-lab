# Integration test settings; credentials belong to throwaway test containers.
MQTT_CONN_LAB_HOST=test-mqtt
MCPLAB_MCP_TOKEN=integration-test-token
MQTT_CONN_TLS_HOST=test-mqtt
MQTT_CONN_TLS_PORT=8883
MQTT_CONN_TLS_USE_TLS=true
MQTT_CONN_TLS_SSL_SKIP_VERIFY=true
MQTT_CONN_STRICT_HOST=test-mqtt
MQTT_CONN_STRICT_PORT=8883
MQTT_CONN_STRICT_USE_TLS=true
