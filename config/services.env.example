# 各 MCP 服務的 runtime 設定範本。
# 執行 python3 scripts/init-config.py 後，會依前綴拆成 config/<服務>/service.env，
# 每個容器只掛載自己的設定目錄。修改 service.env 後不需重啟容器。

# ── Access Control ────────────────────────────
# 設定後 MCP client 必須帶 Authorization: Bearer <token>；留空則不檢查
MCPLAB_MCP_TOKEN=

# ── Datastore Tool Limits ─────────────────────
QUERY_TIMEOUT=60
MSSQL_QUERY_TIMEOUT=
ORACLE_QUERY_TIMEOUT=
MAX_ROWS=
MSSQL_MAX_ROWS=500
ORACLE_MAX_ROWS=500
MSSQL_MAX_CELL_CHARS=4000
ORACLE_MAX_CELL_CHARS=4000
ES_SEARCH_SIZE=10

# ── HTTP Timeouts（秒，1 到 300）─────────────
ES_HTTP_TIMEOUT=30
API_CONTRACT_HTTP_TIMEOUT=15
OIDC_HTTP_TIMEOUT=10
RABBITMQ_HTTP_TIMEOUT=10
MAILPIT_HTTP_TIMEOUT=10

# ── API Contract Response Limits ──────────────
API_CONTRACT_DEFAULT_BODY_BYTES=50000
API_CONTRACT_MAX_BODY_BYTES=200000

# ── SQL Server Connections ────────────────────
# MSSQL_CONN_{ALIAS}_* — ALIAS 為大寫英數（建議用英文代號）
MSSQL_CONN_PROD_NAME=
# 環境標籤（local、dev、test、staging、prod），只用來顯示，各服務的連線都可設定
MSSQL_CONN_PROD_ENVIRONMENT=
MSSQL_CONN_PROD_HOST=
MSSQL_CONN_PROD_PORT=1433
MSSQL_CONN_PROD_USER=
MSSQL_CONN_PROD_PASSWORD=
MSSQL_CONN_PROD_DATABASE=
# 連線到已設定正式憑證的伺服器時，建議改為 false
MSSQL_CONN_PROD_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONN_PROD_CONNECT_TIMEOUT=30

# 第二個 SQL Server（選用）
# MSSQL_CONN_STAGE_NAME=
# MSSQL_CONN_STAGE_HOST=
# MSSQL_CONN_STAGE_PORT=1433
# MSSQL_CONN_STAGE_USER=
# MSSQL_CONN_STAGE_PASSWORD=
# MSSQL_CONN_STAGE_DATABASE=

# ── API Contract Connections ──────────────────
# API_CONTRACT_CONN_{ALIAS}_*
API_CONTRACT_CONN_PROD_NAME=
API_CONTRACT_CONN_PROD_SPEC_URL=
API_CONTRACT_CONN_PROD_SPEC_PATH=
API_CONTRACT_CONN_PROD_BASE_URL=
API_CONTRACT_CONN_PROD_INVOKE_ENABLED=false
API_CONTRACT_CONN_PROD_ALLOWED_METHODS=GET,HEAD,OPTIONS
API_CONTRACT_CONN_PROD_SSL_SKIP_VERIFY=false
API_CONTRACT_CONN_PROD_AUTH_HEADER_NAME=
API_CONTRACT_CONN_PROD_AUTH_HEADER_VALUE=

# ── Oracle Connections ────────────────────────
# ORACLE_CONN_{ALIAS}_*
ORACLE_CONN_PROD_NAME=
ORACLE_CONN_PROD_HOST=
ORACLE_CONN_PROD_PORT=1521
ORACLE_CONN_PROD_SERVICE=
ORACLE_CONN_PROD_USER=
ORACLE_CONN_PROD_PASSWORD=

# ── Elasticsearch Connections ─────────────────
# ES_CONN_{ALIAS}_*  URL 格式：http://host:9200 或 https://host:9200
ES_CONN_PROD_NAME=
ES_CONN_PROD_URL=
ES_CONN_PROD_USER=
ES_CONN_PROD_PASSWORD=
ES_CONN_PROD_SSL_SKIP_VERIFY=

# ── Redis Connections ─────────────────────────
# REDIS_CONN_{ALIAS}_*
REDIS_CONN_PROD_NAME=
REDIS_CONN_PROD_HOST=
REDIS_CONN_PROD_PORT=6379
REDIS_CONN_PROD_DATABASE=
REDIS_CONN_PROD_PASSWORD=
REDIS_CONN_PROD_CONNECT_TIMEOUT=5
REDIS_CONN_PROD_OPERATION_TIMEOUT=10

# ── OIDC Connections ──────────────────────────
# OIDC_CONN_{ALIAS}_*
OIDC_CONN_PROD_NAME=
OIDC_CONN_PROD_ISSUER=
OIDC_CONN_PROD_DISCOVERY_URL=
OIDC_CONN_PROD_AUDIENCE=
OIDC_CONN_PROD_REQUIRE_HTTPS_METADATA=true

# ── MQTT Connections ──────────────────────────
# MQTT_CONN_{ALIAS}_*
MQTT_CONN_PROD_NAME=
MQTT_CONN_PROD_HOST=
MQTT_CONN_PROD_PORT=1883
MQTT_CONN_PROD_USER=
MQTT_CONN_PROD_PASSWORD=

# ── RabbitMQ Connections ──────────────────────
# RABBITMQ_CONN_{ALIAS}_*
RABBITMQ_CONN_PROD_NAME=
RABBITMQ_CONN_PROD_HOST=
RABBITMQ_CONN_PROD_MGMTPORT=15672
RABBITMQ_CONN_PROD_USER=
RABBITMQ_CONN_PROD_PASSWORD=

# ── Mailpit Connections ───────────────────────
# MAILPIT_CONN_{ALIAS}_*
MAILPIT_CONN_PROD_NAME=
MAILPIT_CONN_PROD_URL=

# 本機預設 Mailpit（選用）
MAILPIT_CONN_DEFAULT_NAME=default
MAILPIT_CONN_DEFAULT_URL=http://host.docker.internal:8025

# ── Documents Settings ────────────────────────
DOCUMENT_MAX_IMAGES=20
DOCUMENT_MAX_TEXT_MB=10
DOCUMENT_LIST_DEFAULT_LIMIT=100
DOCUMENT_LIST_MAX_LIMIT=1000
DOCUMENT_LIST_DEFAULT_DEPTH=2
DOCUMENT_LIST_MAX_DEPTH=10
DOCUMENT_SEARCH_DEFAULT_LIMIT=20
DOCUMENT_SEARCH_MAX_LIMIT=200
DOCUMENT_SEARCH_DEFAULT_SCAN_LIMIT=200
DOCUMENT_SEARCH_MAX_SCAN_LIMIT=2000
DOCUMENT_XLSX_MAX_ROWS=1000
DOCUMENT_XLSX_MAX_ROWS_LIMIT=10000
DOCUMENT_XLSX_MAX_CELLS=20000
DOCUMENT_XLSX_MAX_CELLS_LIMIT=200000
