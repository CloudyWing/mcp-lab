<MudDialog Visible="@Visible" VisibleChanged="VisibleChanged" Options="DialogOptions" ActionsClass="dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @if (Draft is not null && Schema is not null) {
            <MudStack Spacing="3">
                <MudTextField T="string" Label="Alias" @bind-Value="Draft.Alias" Immediate="true"
                              HelperText="@($"大寫英數，例如 PROD。變數名稱會是 {Schema.Prefix}_<ALIAS>_<欄位>。")" Required="true" />
                @foreach (ConnectionField field in Schema.Fields) {
                    ConnectionField current = field;
                    string label = current.Required ? $"{current.Name} *" : current.Name;
                    string helpText = HelperText(current);

                    @switch (current.Kind) {
                        case ConnectionFieldKind.Secret:
                            bool isSet = SecretsSet.Contains(current.Name) && !Draft.ClearedSecrets.Contains(current.Name);
                            <div class="secret-field">
                                <MudTextField T="string" Label="@label" InputType="InputType.Password" Immediate="true"
                                              Value="@Draft.NewSecrets.GetValueOrDefault(current.Name)"
                                              ValueChanged="@(value => SetSecret(current.Name, value))"
                                              Placeholder="@(isSet ? "已設定，留空則保持不變" : "")"
                                              HelperText="@helpText" autocomplete="new-password" />
                                @if (SecretsSet.Contains(current.Name)) {
                                    <MudCheckBox T="bool" Label="清除目前的值" Value="@Draft.ClearedSecrets.Contains(current.Name)"
                                                 ValueChanged="@(value => ToggleClear(current.Name, value))" Dense="true" />
                                }
                            </div>
                            break;
                        case ConnectionFieldKind.Bool:
                            <MudSelect T="string" Label="@label" Value="@Draft.Values.GetValueOrDefault(current.Name, "")"
                                       ValueChanged="@(value => Draft.Values[current.Name] = value)" HelperText="@helpText">
                                <MudSelectItem T="string" Value="@("")">使用預設值（@(current.DefaultValue ?? "false")）</MudSelectItem>
                                <MudSelectItem T="string" Value="@("true")">true</MudSelectItem>
                                <MudSelectItem T="string" Value="@("false")">false</MudSelectItem>
                            </MudSelect>
                            break;
                        default:
                            <MudTextField T="string" Label="@label" Immediate="true"
                                          Value="@Draft.Values.GetValueOrDefault(current.Name, "")"
                                          ValueChanged="@(value => Draft.Values[current.Name] = value)"
                                          Placeholder="@(current.DefaultValue ?? "")" HelperText="@helpText" />
                            break;
                    }
                }
                @if (Errors.Count > 0) {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        @foreach (string error in Errors) {
                            <div>@error</div>
                        }
                    </MudAlert>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="CancelAsync">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@Busy" OnClick="SaveAsync">
            @(Busy ? "正在儲存並等待服務重新載入…" : "儲存")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly DialogOptions DialogOptions = new() {
        CloseButton = false,
        CloseOnEscapeKey = true,
        BackdropClick = false,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
    };

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public ConnectionSchema? Schema { get; set; }

    [Parameter]
    public ConnectionDraft? Draft { get; set; }

    [Parameter]
    public IReadOnlySet<string> SecretsSet { get; set; } = new HashSet<string>();

    [Parameter]
    public IReadOnlyList<string> Errors { get; set; } = [];

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    private static string HelperText(ConnectionField field) =>
        field.DefaultValue is null ? field.Description : $"{field.Description}。預設 {field.DefaultValue}";

    private void SetSecret(string field, string? value) {
        if (string.IsNullOrEmpty(value)) {
            Draft!.NewSecrets.Remove(field);
        } else {
            Draft!.NewSecrets[field] = value;
            Draft.ClearedSecrets.Remove(field);
        }
    }

    private void ToggleClear(string field, bool clear) {
        if (clear) {
            Draft!.ClearedSecrets.Add(field);
            Draft.NewSecrets.Remove(field);
        } else {
            Draft!.ClearedSecrets.Remove(field);
        }
    }

    private async Task SaveAsync() {
        if (!Busy) {
            Draft!.Alias = Draft.Alias.Trim().ToUpperInvariant();
            await OnSave.InvokeAsync();
        }
    }

    private async Task CancelAsync() {
        if (!Busy) {
            await VisibleChanged.InvokeAsync(false);
        }
    }
}
