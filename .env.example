COMPOSE_PROJECT_NAME=mcp-lab
TZ=Asia/Taipei

# ── Base Images ───────────────────────────────
PYTHON_TAG=3.12-slim
DOTNET_TAG=10.0

# ── MCP Ports ─────────────────────────────────
# 資料庫服務 (9800-9819)
MCP_SQL_SERVER_PORT=9800
MCP_ORACLE_PORT=9801
MCP_ELASTICSEARCH_PORT=9802
MCP_REDIS_PORT=9803

# 訊息服務 (9820-9839)
MCP_MOSQUITTO_PORT=9820
MCP_RABBITMQ_PORT=9821

# 工具服務 (9830-9839)
MCP_MAILPIT_PORT=9830

# 文件服務 (9840-9859)
MCP_READER_PORT=9840

# 身分與 API 服務 (9850-9859)
MCP_OIDC_PORT=9850
MCP_API_CONTRACT_PORT=9851

# 系統服務 (9860-9879)，需以 docker compose --profile docker 啟動
MCP_DOCKER_PORT=9860

# MCP 對外埠綁定位址，預設只允許本機連線
MCP_BIND_ADDRESS=127.0.0.1

# ── Docker / Compose Service ──────────────────
DOCKER_GID=1001
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ── Local Smoke Test ──────────────────────────
MCP_SMOKE_INCLUDE_ORACLE=false
MCP_SMOKE_TIMEOUT_SECONDS=15
MCP_SMOKE_MAILPIT_SMTP_HOST=127.0.0.1
MCP_SMOKE_MAILPIT_SMTP_PORT=1025

# ── Documents Settings ────────────────────────
DOCUMENT_HOST_MOUNT_ROOT=
